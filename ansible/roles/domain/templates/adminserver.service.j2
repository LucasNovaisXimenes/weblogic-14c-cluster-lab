[Unit]
Description=Oracle WebLogic AdminServer
After=network.target weblogic-nodemanager.service
Requires=weblogic-nodemanager.service

[Service]
Type=simple
User={{ oracle_user }}
Group={{ oracle_group }}
Environment="JAVA_HOME=/usr/lib/jvm/java-{{ jdk_major }}-openjdk-amd64"
Environment="WL_HOME={{ middleware_home }}/wlserver"
Environment="DOMAIN_HOME={{ domain_home }}"
WorkingDirectory={{ domain_home }}
ExecStart={{ domain_home }}/startWebLogic.sh
ExecStop={{ domain_home }}/bin/stopWebLogic.sh
Restart=on-failure
RestartSec=30
StandardOutput=append:{{ domain_home }}/servers/AdminServer/logs/AdminServer.out
StandardError=append:{{ domain_home }}/servers/AdminServer/logs/AdminServer.out

[Install]
WantedBy=multi-user.target
